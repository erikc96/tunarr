#!/bin/bash
# Watchdog (crontab */5): start the live proxy if it isn't running.
# yt-dlp runs inside the youtarr container and goes out through Youtarr's
# ProtonVPN SOCKS proxy (YouTube bot-walls the box's own IPs). The proxy URL
# is read from Youtarr's config so its password lives in one place.
cd "$(dirname "$0")"
pgrep -u "$USER" -f "^[^ ]*python3 live_proxy[.]py" >/dev/null && exit 0
proxy=$(jq -r '.proxy // empty' ~/youtarr/config/config.json)
export YTDLP="podman exec youtarr /opt/yt-dlp/yt-dlp"
export YTDLP_ARGS="${proxy:+--proxy $proxy}"
nohup python3 live_proxy.py >> live_proxy.log 2>&1 < /dev/null &
